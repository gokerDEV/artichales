~~~ts
type Result = {
  sample: string;
  od: number;
};

const computeMean = (rows: Result[]): number => {
  const total = rows.reduce((acc, row) => acc + row.od, 0);
  return Number((total / rows.length).toFixed(3));
};
~~~

